[Unit]
Description=Super Agent Quantitative Analysis API
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=superagent
Group=superagent
WorkingDirectory=/opt/super-agent/current
EnvironmentFile=-/etc/super-agent/super-agent.env
Environment=SUPER_AGENT_RUNTIME_GUARD=1
ExecStart=/opt/super-agent/current/.venv/bin/python -u /opt/super-agent/current/api_service/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/super-agent/data /opt/super-agent/logs /opt/super-agent/reports
[Install]
WantedBy=multi-user.target
